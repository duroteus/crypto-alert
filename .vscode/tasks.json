            "type": "npm",
            "script": "start:telegram",
            "runOptions": {
                "runOn": "folderOpen"
            },
            "presentation": {
                "group": "workers"
            }
        },
        {
            "label": "🌐 Start: API",
            "type": "npm",
            "script": "start:api",
            "runOptions": {
                "runOn": "folderOpen"
            },
